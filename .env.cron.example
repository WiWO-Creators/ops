# Archivo independiente del frontend. Copiar a .env.cron; nunca versionar su secreto.
OPS_CRON_BASE_URL=https://board.wiwo.me/index.php/api/cron
# Mismo secreto que application/config/ops-cron.php en el backend. Generar una sola vez.
OPS_CRON_SECRET=
# Corte diario confirmado, horario America/Santiago. 20:00 para toda la empresa desde la migracion
# 0430 del board. Tiene que decir LO MISMO que `GET /api/cron/estado` (o sea, que la variable
# OPS_TIMER_CUTOFF_HOUR del deploy del board): si no coinciden, el programador no arranca.
OPS_TIMER_CUTOFF_HOUR=20:00
# Frecuencia de las rutinas PHP y recuperación de cortes perdidos.
OPS_CRON_POLL_SCHEDULE="*/5 * * * *"
OPS_CRON_LIVE_SCHEDULE="*/15 * * * *"
OPS_CRON_TRASH_SCHEDULE="0 3 * * *"
# Resumen del día del equipo. 20:00 de Santiago; es la única fuente de esa hora.
OPS_CRON_RESUMEN_SCHEDULE="0 20 * * *"
# Recordatorio a quien no abrió jornada. 10:00 de Santiago, hora confirmada por el cliente.
OPS_CRON_RECORDATORIO_JORNADA_SCHEDULE="0 10 * * *"
# Recordatorio a quien tiene jornada abierta y no registró tareas. 15:00 de Santiago.
OPS_CRON_RECORDATORIO_TAREAS_SCHEDULE="0 15 * * *"
OPS_CRON_REQUEST_TIMEOUT_MS=240000
