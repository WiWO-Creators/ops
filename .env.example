# Base de la API v1 de wiwo-board, sin barra final.
#   Podman local: http://localhost:8091/api/v1
#   Mock:         http://localhost:3001/api/v1
API_BASE=http://localhost:8091/api/v1

# Clave de 32 bytes en hexadecimal para cifrar la cookie de sesion.
#   openssl rand -hex 32
SESION_CLAVE=

# --- Teletrabajo (LiveKit) ---
# Sin estas tres, la portada de Teletrabajo se ve pero las salas no abren.
# El par clave/secreto sale de: docker run --rm livekit/livekit-server generate-keys
# El secreto NUNCA llega al navegador: solo lo usa `datos/teletrabajo.ts`, que es server-only.
LIVEKIT_URL=wss://livekit.wiwo.me
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cabecera con la que viaja el token: `authorization` (por defecto) o `x-api-key`.
# Bajo CGI/FastCGI Apache no propaga `Authorization`. Consultar GET /api/v1/health al desplegar:
# si `auth_header_visible` es false y `api_key_visible` es true, poner x-api-key.
API_CABECERA_TOKEN=authorization
