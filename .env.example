# Base de la API v1 de wiwo-board, sin barra final.
#   Podman local: http://localhost:8091/api/v1
#   Mock:         http://localhost:3001/api/v1
API_BASE=http://localhost:8091/api/v1

# Opcional. Espera maxima del BFF a la API, en milisegundos (por defecto 25000), y la de las rutas
# de IA `ia/*`, que esperan a un modelo (por defecto 95000).
# API_TIEMPO_MS=25000
# API_TIEMPO_IA_MS=95000

# Clave de 32 bytes en hexadecimal para cifrar la cookie de sesion.
#   openssl rand -hex 32
SESION_CLAVE=

# --- Teletrabajo (LiveKit) ---
# Sin estas tres, la portada de Teletrabajo se ve pero las salas no abren.
# El par clave/secreto sale de: docker run --rm livekit/livekit-server generate-keys
# El secreto NUNCA llega al navegador: solo lo usa `datos/teletrabajo.ts`, que es server-only.
LIVEKIT_URL=wss://livekit.wiwo.me
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cabecera con la que viaja el token: `authorization` (por defecto) o `x-api-key`.
# Bajo CGI/FastCGI Apache no propaga `Authorization`. Consultar GET /api/v1/health al desplegar:
# si `auth_header_visible` es false y `api_key_visible` es true, poner x-api-key.
API_CABECERA_TOKEN=authorization

# --- Panel clasico (Perfex) ---
# Origen del panel viejo, SIN barra final. Lo usa `src/lib/panel-clasico.ts` para el enlace
# "Abrir en el panel clasico" que lleva toda pantalla nueva.
# Es `NEXT_PUBLIC_` porque el enlace se pinta en el navegador. Sin ella el enlace no se dibuja:
# la funcion devuelve `null` antes que mandar a un 404.
#   Produccion: https://board.wiwo.me
# Vacia a proposito: el panel clasico local (contenedor `board-web`) no siempre esta levantado.
NEXT_PUBLIC_BOARD_URL=

# Cada cuantos segundos el panel manda el latido de presencia que alimenta el centro de auditoria.
# Sube el numero si la API sufre; bajalo si "Ahora mismo" se ve con retraso. La pestaña oculta no late.
#   Por defecto: 45
PRESENCIA_INTERVALO_SEGUNDOS=45

# Secreto compartido con la API para que crea la IP y el navegador que este servidor le reenvia.
# Sin ella, la auditoria guarda la IP del servidor de Ops y el user agent `node` en cada sesion.
# Tiene que ser EL MISMO valor que `WIWO_PROXY_SECRETO` en la API
# (variable de entorno del contenedor o `application/storage/secure/.env` de wiwo-board).
#   openssl rand -hex 32
# Comprobacion: GET /api/v1/health responde `origen_confiable: true` cuando el par esta bien puesto.
PROXY_SECRETO=

# --- Aviso de version nueva ---
# Que version dice servir este proceso. Es lo que compara la pestaña abierta para saber que su
# JavaScript quedo viejo y ofrecer "Actualizar".
# Opcional: sin ella se usa `.next/BUILD_ID`, que ya cambia en cada build. Ponla solo si el
# despliegue no deja `.next` junto al servidor (contenedor, artefacto copiado) o si prefieres
# fijarla al SHA del commit.
#   Ej: OPS_VERSION=$(git rev-parse --short HEAD)
OPS_VERSION=

# Cada cuantos segundos una pestaña abierta pregunta por la version. Con la pestaña oculta no
# pregunta, y al volver al frente pregunta enseguida.
#   Por defecto: 300 — se acota entre 30 y 3600
VERSION_INTERVALO_SEGUNDOS=300

# --- Drive de la Tarea: subida de archivos ---
# Tope de una subida completa. Es NEXT_PUBLIC_ porque el navegador rechaza de antemano lo que pasa
# del tope, antes de armar el pedido. Tiene que ser el mismo tope que usa la API para
# POST /drive/{folder_id}/upload-sessions.
#   Por defecto: 2147483648 (2 GB)
NEXT_PUBLIC_DRIVE_TOPE_SUBIDA_BYTES=

# Cuantas subidas de la bandeja van a la vez. Mas satura la conexion de quien sube sin terminar antes.
#   Por defecto: 3
NEXT_PUBLIC_DRIVE_SUBIDAS_EN_PARALELO=

# --- Taller ---
# Proyecto que monta /taller/tareas para ver la pestaña Tareas y el Registro de horas aislados,
# contra la API configurada y con una sesion abierta. Se lee al construir: cambiarlo pide build.
#   Por defecto: vacio — la pagina explica que falta en vez de montar un proyecto al azar
TALLER_PROYECTO_ID=

# --- En vivo ---
# Servicio de avisos en tiempo real y edicion conjunta del Meeting Paper (`servicios/en-vivo/`).
# Lo leen el servidor de Next y el propio servicio, desde este mismo .env. Todo apagado por defecto:
# sin NEXT_PUBLIC_EN_VIVO_URL y sin la opcion `wiwo_en_vivo` encendida en la API, el panel no se conecta.
#
# Secreto compartido con la API (`EN_VIVO_SECRETO` en wiwo-board) que firma los avisos y las lecturas
# de actas en los dos sentidos. Minimo 32 caracteres.
#   openssl rand -hex 32
EN_VIVO_SECRETO=
# Secreto de los boletos que el panel entrega al navegador. SOLO de este .env y distinto del anterior.
#   openssl rand -hex 32
EN_VIVO_BOLETO_SECRETO=
# URL publica del servicio para el navegador (es NEXT_PUBLIC_: se lee en el navegador).
#   Produccion: wss://ops.wiwo.me/en-vivo    Local: ws://localhost:4010/en-vivo
NEXT_PUBLIC_EN_VIVO_URL=
# Donde escucha el servicio. Detras de un proxy se queda en 127.0.0.1.
#   Por defecto: 4010 y 127.0.0.1
EN_VIVO_PUERTO=4010
EN_VIVO_HOST=127.0.0.1
# Prefijo de las rutas del servicio, con barra inicial y sin barra final.
#   Por defecto: /en-vivo
EN_VIVO_PREFIJO=/en-vivo
# Origenes del navegador que pueden abrir un socket, separados por comas.
#   Produccion: https://ops.wiwo.me    Local: http://localhost:3000
EN_VIVO_ORIGENES=http://localhost:3000
# Tiempos del guardado de las actas, en milisegundos: espera tras la ultima edicion, tope entre
# guardados y espera maxima a la API.
#   Por defecto: 2000, 10000 y 5000
# EN_VIVO_DEBOUNCE_MS=2000
# EN_VIVO_MAX_DEBOUNCE_MS=10000
# EN_VIVO_TIEMPO_API_MS=5000
# Conexiones simultaneas al bus. Por defecto: 2000
# EN_VIVO_MAX_CONEXIONES=2000

# --- Chequeo de salud para el monitor externo ---
# Token que habilita el DETALLE de `GET /api/salud` (cabecera `x-salud-token`). Sin el, la ruta solo
# dice si el BFF y la API estan bien. Tiene que ser EL MISMO valor que `WIWO_SALUD_TOKEN` en la API,
# porque el BFF se lo reenvia a `GET /api/v1/health` para traer el detalle de base, disco y correo.
WIWO_SALUD_TOKEN=
